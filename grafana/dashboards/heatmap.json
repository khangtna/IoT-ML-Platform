{
  "title": "Smart City - Heatmap",
  "uid": "smartcity-heatmap",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "smart-city"
  ],
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Trạm",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "TimescaleDB"
        },
        "query": "SELECT DISTINCT station_id FROM sensor_metrics ORDER BY station_id",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Phân bố PM2.5 theo thời gian",
      "type": "heatmap",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, station_id AS metric, pm25 AS value FROM sensor_metrics WHERE $__timeFilter(timestamp) AND station_id IN (${station:sqlstring}) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "concentrationugm3"
        },
        "overrides": []
      },
      "options": {
        "calculate": true,
        "calculation": {
          "xBuckets": {
            "mode": "size",
            "value": "1h"
          },
          "yBuckets": {
            "mode": "size",
            "value": "10"
          }
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "unit": "concentrationugm3"
        }
      }
    }
  ]
}
